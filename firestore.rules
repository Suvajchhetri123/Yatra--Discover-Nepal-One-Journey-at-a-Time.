rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // HELPERS
    // ------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }

    // ------------------------------------------------------------
    // USERS
    // users/{firebaseUid}
    // ------------------------------------------------------------

    match /users/{userId} {

      // A logged-in user can create only their own profile.
      //
      // New accounts must begin as tourists.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'tourist';

      // Users can read their own profile.
      // Admins can read profiles for administration.
      allow read: if isOwner(userId) || isAdmin();

      // A normal tourist may update only profile/preferences fields.
      //
      // They cannot give themselves admin privileges or replace account
      // ownership/security fields.
      allow update: if isOwner(userId)
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'phone',
            'touristType',
            'language',
            'emergencyContactName',
            'emergencyContactPhone',
            'updatedAt'
          ]);

      // Do not allow client-side profile deletion for now.
      allow delete: if false;
    }

    // ------------------------------------------------------------
    // BOOKINGS
    // bookings/{bookingId}
    // ------------------------------------------------------------

    match /bookings/{bookingId} {

      // Tourist can create a booking only for themselves.
      //
      // New bookings must always start as Pending and without a coordinator.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.assignedCoordinator == null;

      // Tourist can read their own bookings.
      // Admin can read all bookings.
      allow read: if isSignedIn()
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      // Tourist cancellation:
      //
      // Pending -> Cancelled only.
      // No route/cost/user/coordinator editing is allowed.
      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'updatedAt'
          ]);

      // Admin may later change booking status and coordinator assignment.
      allow update: if isAdmin()
        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'status',
            'assignedCoordinator',
            'updatedAt'
          ]);

      // Keep booking history instead of deleting documents.
      allow delete: if false;
    }

    // ------------------------------------------------------------
    // COORDINATORS
    // coordinators/{coordinatorId}
    // Admin-managed registry of staff that can be assigned to a booking.
    // ------------------------------------------------------------

    match /coordinators/{coordinatorId} {

      // Admins see the whole registry, including deactivated records.
      //
      // Everyone else may read an ACTIVE coordinator only. A document without
      // the `active` flag is treated as not active, so an unexpected document
      // fails closed rather than leaking.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.active == true);

      // Only admins may manage coordinator records, and a record must always
      // carry the fields the registry depends on.
      allow create, update: if isAdmin()
        && request.resource.data
          .keys()
          .hasAll([
            'name',
            'phone',
            'email',
            'active'
          ]);

      // A coordinator is retired with `active: false`, never deleted, so
      // booking snapshots that reference one stay meaningful.
      allow delete: if false;
    }

    // ------------------------------------------------------------
    // PLACES
    // places/{placeId}
    // Admin-curated destination catalog.
    // ------------------------------------------------------------

    match /places/{placeId} {

      // Admins see every place; everyone else only active ones.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.active == true);

      // Only admins may curate places. Domestic/international entry-fee
      // overrides are stored in the same document as the universal fee.
      allow create, update: if isAdmin()
        && request.resource.data
          .keys()
          .hasAll([
            'name',
            'location',
            'entryFee',
            'active'
          ]);

      // Removal is `active: false`, so itineraries referencing a place still
      // resolve.
      allow delete: if false;
    }

    // ------------------------------------------------------------
    // PACKAGES
    // packages/{packageId}
    // Admin-curated tour package catalog.
    // ------------------------------------------------------------

    match /packages/{packageId} {

      // Admins see every package; everyone else only active ones.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.active == true);

      // Only admins may curate packages.
      allow create, update: if isAdmin()
        && request.resource.data
          .keys()
          .hasAll([
            'title',
            'region',
            'price',
            'durationDays',
            'active'
          ]);

      // Removal is `active: false`, so a booked package is never destroyed.
      allow delete: if false;
    }

    // ------------------------------------------------------------
    // DEFAULT
    // ------------------------------------------------------------

    // Any collection not explicitly covered above is denied automatically.
  }
}